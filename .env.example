# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git, so your secrets never get committed.

# --- Supabase ---
# Dashboard → Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key is safe to expose in the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# The "secret" key bypasses RLS. Used only by the import script and the rate-limit counter.
# Server only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Site ---
# Where this app runs. Login emails link back here. Use your Vercel URL in production.
SITE_URL=http://localhost:3000

# --- Anthropic (used from Phase 3 on) ---
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
